async def save_link(
    crawl_id,
    source,
    link
):

    async with aiosqlite.connect(
        DATABASE_PATH
    ) as db:

        await db.execute(
            """
            INSERT INTO links
            (
                crawl_id,
                source_url,
                destination_url,
                anchor,
                internal,
                nofollow,
                sponsored,
                ugc
            )
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)
            """,
            (
                crawl_id,
                source,
                link["url"],
                link.get("anchor"),
                int(link.get("internal")),
                int(link.get("nofollow")),
                int(link.get("sponsored")),
                int(link.get("ugc"))
            )
        )

        await db.commit()


